# Website Monitor — environment variables (all optional)

# Target URL to monitor (or pass as the first CLI arg).
WEBSITE_URL=https://your-site.example.com

# Navigation timeout in milliseconds.
TIMEOUT_MS=30000

# Where screenshots + status.json are written.
OUTPUT_DIR=website-status

# Optional: treat the site as UP if the final URL (after redirects) contains
# this substring. Useful for sites that redirect to a login/auth host.
EXPECTED_URL_CONTAINS=

# Comma-separated strings that mark the page as DOWN if found in the body.
ERROR_PATTERNS=404 Not Found,NoSuchBucket,Code: NoSuchBucket

# --- Slack notifications (optional) ---
# Enable by setting both SLACK_BOT_TOKEN and SLACK_CHANNEL.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=#alerts
# Set to "true" to also notify when the site is UP.
SLACK_NOTIFY_ON_SUCCESS=false

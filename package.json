    "playwright:install": "playwright install chromium"
  },
  "keywords": [
    "website-monitor",
    "uptime",
    "playwright",
    "screenshot",
    "monitoring"
  ],
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.49.0"
  }
}

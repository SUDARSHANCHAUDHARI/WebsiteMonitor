{
  "name": "website-monitor",
  "version": "2.0.0",
  "description": "Generic website uptime monitor with screenshot capture and optional Slack alerts. Point it at any URL.",
  "main": "monitor.js",
  "bin": {
    "website-monitor": "monitor.js"
  },
  "scripts": {
    "monitor": "node monitor.js",
    "test": "node --test tests/unit.test.js",
